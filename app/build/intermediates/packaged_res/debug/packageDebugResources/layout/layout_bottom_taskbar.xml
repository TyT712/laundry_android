<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomTaskbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <Button
        android:id="@+id/navOrders"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_nav_orders"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="2dp"
        android:text="@string/nav_orders"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/navCustomers"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_nav_customers"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="2dp"
        android:text="@string/nav_customers"
        android:textSize="11sp" />

    <Button
        android:id="@+id/navServices"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_nav_services"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="2dp"
        android:text="@string/nav_services"
        android:textSize="11sp" />

    <Button
        android:id="@+id/navStats"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_nav_stats"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="2dp"
        android:text="@string/nav_stats"
        android:textSize="11sp" />

    <Button
        android:id="@+id/navProfile"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableTop="@drawable/ic_nav_profile"
        android:drawablePadding="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="2dp"
        android:text="@string/nav_profile"
        android:textSize="11sp" />
</LinearLayout>
