<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Form">

        <TextView
            style="@style/Title"
            android:text="@string/register_title" />

        <EditText
            android:id="@+id/edRegFullname"
            style="@style/Field"
            android:hint="@string/label_fullname"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edRegPhone"
            style="@style/Field"
            android:hint="@string/label_phone"
            android:inputType="phone" />

        <EditText
            android:id="@+id/edRegUsername"
            style="@style/Field"
            android:hint="@string/hint_username"
            android:inputType="text" />

        <EditText
            android:id="@+id/edRegPassword"
            style="@style/Field"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <TextView
            style="@style/Info"
            android:text="@string/register_role_note" />

        <Button
            android:id="@+id/btnRegisterSubmit"
            style="@style/Action"
            android:text="@string/action_register_submit" />

        <Button
            android:id="@+id/btnBackLogin"
            style="@style/Action"
            android:text="@string/action_back_login" />
    </LinearLayout>
</ScrollView>

