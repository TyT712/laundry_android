<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout style="@style/Form">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/main_title" />

                <Button
                    android:id="@+id/btnLogout"
                    style="@style/Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_logout" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentUser"
                style="@style/Label"
                android:layout_marginBottom="8dp"
                android:textStyle="normal" />

            <Button
                android:id="@+id/btnOrder"
                style="@style/Action"
                android:text="@string/action_new_order" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/orders_header" />

            <EditText
                android:id="@+id/edSearch"
                style="@style/Field"
                android:hint="@string/hint_search_orders"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSearch"
                    style="@style/Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/action_search" />

                <Button
                    android:id="@+id/btnViewOrders"
                    style="@style/Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/action_refresh" />
            </LinearLayout>

            <ListView
                android:id="@+id/listOrders"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_taskbar" />
</LinearLayout>
