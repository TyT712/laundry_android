<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:text="@string/profile_title"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCloseProfile"
            style="@style/ActionSecondary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/action_back"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card thông tin tài khoản -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/primary_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvProfileUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/primary_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card sửa thông tin cá nhân -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="0dp"
                        android:text="@string/label_fullname" />

                    <EditText
                        android:id="@+id/edProfileFullname"
                        style="@style/Field"
                        android:inputType="textPersonName" />

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_phone" />

                    <EditText
                        android:id="@+id/edProfilePhone"
                        style="@style/Field"
                        android:inputType="phone" />

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_new_password" />

                    <EditText
                        android:id="@+id/edProfilePassword"
                        style="@style/Field"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/btnSaveProfile"
                        style="@style/Action"
                        android:layout_marginTop="20dp"
                        android:text="@string/action_save_profile" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Quản trị & Sao lưu dữ liệu (Phase 4) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManagerTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="0dp"
                        android:text="SAO LƯU DỮ LIỆU CỬA HÀNG" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Xuất toàn bộ khách hàng, dịch vụ và đơn giặt ra tệp JSON an toàn."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnExportBackup"
                        style="@style/ActionSecondary"
                        android:layout_height="44dp"
                        android:text="Xuất file sao lưu (JSON Backup)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Taskbar -->
    <include layout="@layout/layout_bottom_taskbar" />
</LinearLayout>
