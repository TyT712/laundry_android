<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/Title"
            android:text="@string/customers_title" />

        <EditText
            android:id="@+id/edCustomerName"
            style="@style/Field"
            android:hint="@string/hint_customer_name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edCustomerPhone"
            style="@style/Field"
            android:hint="@string/hint_customer_phone"
            android:inputType="phone" />

        <EditText
            android:id="@+id/edCustomerAddress"
            style="@style/Field"
            android:hint="@string/hint_customer_address"
            android:inputType="textPostalAddress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveCustomer"
                style="@style/Action"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/action_save_customer" />

            <Button
                android:id="@+id/btnClearCustomer"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:text="@string/action_cancel_edit" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginTop="12dp"
            android:text="@string/customers_list_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edSearchCustomer"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_search_customers"
                android:inputType="text" />

            <Button
                android:id="@+id/btnSearchCustomer"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:text="@string/action_find" />

            <Button
                android:id="@+id/btnResetCustomerSearch"
                style="@style/Action"
                android:layout_width="wrap_content"
                android:text="@string/action_all" />
        </LinearLayout>

        <ListView
            android:id="@+id/listCustomers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_taskbar" />
</LinearLayout>
